# General settings
autodetach on             # Detach on hangup
startup_message off       # Don't display the copyright page
pow_detach_msg "Screen session of $LOGNAME $:cr:$:nl:ended."  # Logout message

# Scrollback settings
defscrollback 5000        # Set scrollback buffer size
termcapinfo xterm|xterms|xs|rxvt ti@:te@  # Enable terminal scrolling

# Fix for 256 colors - add this to fix lolcat
term screen-256color      # Force 256 color support
attrcolor b ".I"          # Allow bold colors
termcapinfo xterm 'Co#256:AB=\E[48;5;%dm:AF=\E[38;5;%dm'  # Tell screen how to set colors

# Status bar
caption always "%u%{wk}%?%-Lw%?%{bw}%n*%f %t%?(%u)%?%{wk}%?%+Lw %=  %{mk}host:%H Load:%l  %{ck}%M%{wk} %{ck}%d %{gk}%c"

# Key bindings
bindkey -k k5 prev        # F5 for previous window
bindkey -k k6 next        # F6 for next window

# Scroll bindings
bindkey -d "^[[5S" eval copy "stuff 5\025"    # Scroll up
bindkey -m "^[[5S" stuff 5\025
bindkey -d "^[[5T" eval copy "stuff 5\004"    # Scroll down
bindkey -m "^[[5T" stuff 5\004
bindkey -d "^[[25S" eval copy "stuff \025"    # Scroll up more
bindkey -m "^[[25S" stuff \025
bindkey -d "^[[25T" eval copy "stuff \004"    # Scroll down more
bindkey -m "^[[25T" stuff \004
